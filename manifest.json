{
  "manifest_version": 3,
  "name": "The Cookie Auditor",
  "version": "0.3.0",
  "description": "Privacy audit tool for inspecting cookie usage on web pages.",
  "permissions": [
    "cookies",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "The Cookie Auditor",
    "default_popup": "popup.html"
  }
}
